# =====================================================================
# CareShift Guard  環境変数のひな形
#
#   cp .env.example .env  したうえで値を設定する。
#   .env は .gitignore で除外されており、絶対にコミットしない。
# =====================================================================

# --- データベース ---
POSTGRES_DB=careshift
POSTGRES_USER=careshift
# 本番では 32 文字以上のランダム文字列を使う
#   openssl rand -base64 32
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy 用の接続文字列（compose 内では上記から組み立てる）
DATABASE_URL=postgresql+pg8000://careshift:change_me_in_production@db:5432/careshift

# --- アプリケーション ---
# セッション Cookie の署名鍵。必ず変更する
#   openssl rand -hex 32
SECRET_KEY=change_me_in_production
# development | production
APP_ENV=development
# シフト最適化の求解上限（秒）
SOLVER_TIME_LIMIT=10
# 求解に使うワーカー数。割り当て OCPU 数に合わせる（本番 VM1 は 2）
SOLVER_WORKERS=2

# --- 公開 URL（TLS 証明書の取得に使う） ---
PUBLIC_HOSTNAME=localhost
LETSENCRYPT_EMAIL=

# --- ビルド時の切り替え ---
# true にすると開発用依存（pytest / ruff / pglast）を含めてビルドする。
# デモでコンテナ自身にテストを実行させる場合に使う。
# 顧客提供イメージでは false のままにする。
INSTALL_DEV=true

# ---------------------------------------------------------------------
# 公開URLの基点
#   パスワード再設定リンクのような「外部に渡す絶対URL」を組むのに使う。
#   逆プロキシとロードバランサを経由すると、アプリから見える
#   ホスト名・ポート・プロトコルは利用者が見ているものと一致しない。
#   本番では必ず設定する（未設定だと起動時に失敗する）。
# ---------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8080
